{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:templinio:schema:lifecycle:0.1.0",
  "title": "Templinio lifecycle dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "sources",
    "technologies",
    "releaseCycles",
    "events"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "technologies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/technology" }
    },
    "releaseCycles": {
      "type": "array",
      "items": { "$ref": "#/$defs/releaseCycle" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "dateOrNull": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "retrievedAt", "license", "licenseUrl"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "license": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string", "format": "uri" }
      }
    },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "category", "homepage", "aliases", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["runtime", "language", "framework", "database", "operating-system", "tool"]
        },
        "homepage": { "type": "string", "format": "uri" },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "releaseCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "technologyId", "name", "releaseDate", "eolDate", "isLts", "status", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "technologyId": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "releaseDate": { "$ref": "#/$defs/dateOrNull" },
        "eolDate": { "$ref": "#/$defs/dateOrNull" },
        "isLts": { "type": ["boolean", "null"] },
        "status": { "enum": ["active", "end-of-life", "scheduled", "unknown"] },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "technologyId", "releaseCycleId", "type", "title", "date", "dateStatus", "sourceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "technologyId": { "$ref": "#/$defs/identifier" },
        "releaseCycleId": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "type": { "enum": ["release", "support-start", "end-of-life", "milestone"] },
        "title": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/dateOrNull" },
        "dateStatus": { "enum": ["occurred", "scheduled", "estimated", "unknown"] },
        "sourceIds": { "$ref": "#/$defs/sourceIds" }
      }
    }
  }
}
